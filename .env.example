# ==============================================================================
# Kyron Realty AI — Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 17)
DATABASE_URL="postgres://kyron_realty_ai_user:password@localhost:5432/kyron_realty_ai"

# App Environment & Base Path
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth v5 Configuration
AUTH_SECRET="your-32-byte-hex-secret-here"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000/projects/kyron-realty-ai"

# Google OAuth 2.0 Credentials
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Key & Model
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional: a different model for hyper-local area research (defaults to GEMINI_MODEL)
# GEMINI_ENRICHMENT_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 2. Google Maps Platform
# Server key: Routes API distances for nearby places (absent = no distances).
# Public key: the Maps Embed shown in the onboarding studio (referrer-restricted).
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY="your_google_maps_server_key_here"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY="your_google_maps_embed_key_here"

# ------------------------------------------------------------------------------
# 3. Agora Real-Time Voice Engine & Conversational AI Keys
# Get from: Agora Console -> https://console.agora.io/
# ------------------------------------------------------------------------------
# Agora Project App ID
AGORA_APP_ID="your_agora_app_id_here"
NEXT_PUBLIC_AGORA_APP_ID="your_agora_app_id_here"

# Agora App Certificate (Used by backend to sign secure RTC tokens)
AGORA_APP_CERTIFICATE="your_agora_app_certificate_here"

# Agora Conversational AI Cloud Gateway credentials: Customer ID + Secret (Basic auth)
AGORA_CUSTOMER_ID="your_agora_customer_id_here"
AGORA_CUSTOMER_SECRET="your_agora_customer_secret_here"
# Alternative: a single REST API key instead of the Customer ID + Secret pair
# AGORA_CONVERSATIONAL_AI_API_KEY="your_agora_conversational_ai_api_key_here"

# Optional: speech recognition vendor for the agent ("ares" by default; "deepgram" needs a key)
# AGORA_ASR_VENDOR="deepgram"
# DEEPGRAM_API_KEY="your_deepgram_api_key"

# ------------------------------------------------------------------------------
# 4. Optional: Voice Synthesis (TTS) - BYOK (Bring Your Own Key)
# Default: Agora Managed TTS (MiniMax speech-2.6-turbo) is used automatically
# when no BYOK key is set. No additional vendor keys or subscriptions required!
# Uncomment any one provider below if you wish to override with your own key:
# ------------------------------------------------------------------------------
# ElevenLabs
# ELEVENLABS_API_KEY="your_elevenlabs_api_key"
# ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# OpenAI TTS (OPENAI_API_KEY also serves as the fallback LLM when GEMINI_API_KEY is unset)
# OPENAI_API_KEY="your_openai_api_key"
# OPENAI_MODEL="gpt-4o-mini"

# Cartesia
# CARTESIA_API_KEY="your_cartesia_api_key"
# CARTESIA_VOICE_ID="a0e99841-438c-4a64-b679-ae501e7d6091"

# Microsoft Azure Speech
# MICROSOFT_TTS_KEY="your_azure_speech_key"
# MICROSOFT_TTS_REGION="eastus"
# MICROSOFT_TTS_VOICE="en-US-JennyMultilingualNeural"
