# Database Configuration (PostgreSQL 17)
DATABASE_URL="postgres://postgres:password@localhost:5432/kyron_realty_ai"

# Application Environment
NODE_ENV="production"
PORT=3000

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth v5 Configuration
# Generate a secure secret with: openssl rand -hex 32 or npx auth secret
AUTH_SECRET="your-random-32-character-secret-key"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (from Google Cloud Console > APIs & Services > Credentials)
# Set Authorized redirect URI to: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI / LLM API Keys (optional / as needed)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
